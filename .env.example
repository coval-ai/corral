# Copy to .env and fill in. Real .env files are gitignored.

#################
# Coval API Key #
#################

# You need this to benchmark with coval
COVAL_API_KEY=

# Bearer Coval presents to the served agent; unset means open.
S2S_AGENT_TOKEN=


#####################
# Provider API Keys #
#####################

# Needed to run the models. Just make sure you have keys for the models you're
# trying to run :)
DEEPGRAM_API_KEY=
ELEVENLABS_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
SONIOX_API_KEY=
