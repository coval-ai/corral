# Copy to .env and fill in. Real .env files are gitignored.

# --- Provider keys, per stack ---
DEEPGRAM_API_KEY=
OPENAI_API_KEY=
ELEVENLABS_API_KEY=
SONIOX_API_KEY=
GEMINI_API_KEY=

# --- Coval ---
COVAL_API_KEY=
# Bearer Coval presents to the served agent; unset means open.
S2S_AGENT_TOKEN=
# Ultra Bank test set, persona, and the board's metrics (the fetch reads the same ids).
COVAL_S2S_BANK_TEST_SET_ID=
COVAL_S2S_BANK_PERSONA_ID=
COVAL_S2S_LATENCY_METRIC_ID=
COVAL_S2S_INSTRUCTION_METRIC_ID=
COVAL_S2S_INTERRUPTION_METRIC_ID=
COVAL_S2S_CALL_LENGTH_METRIC_ID=
