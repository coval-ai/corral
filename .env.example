# Copy to .env and fill in. Real .env files are gitignored.

#################
# Coval API Key #
#################

# You need this to benchmark with coval. The agent uses it to ask which test
# case is calling, so the key needs simulations:read.
COVAL_API_KEY=

# Workspace benchmarks run in. Leave it empty and Corral will create its own workspace.
CORRAL_WORKSPACE_ID=
CORRAL_ASSETS_URI=


#####################
# Provider API Keys #
#####################

# Needed to run the models. Just make sure you have keys for the models you're
# trying to run :)
DEEPGRAM_API_KEY=
ELEVENLABS_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
SONIOX_API_KEY=
XAI_API_KEY=
